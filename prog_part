def main():
    print("Grid path S to G, order: up left right down\n")
    width = int(input("width of grid: "))
    height = int(input("height of grid: "))
    print("row and col start at 0 0  (valid row 0 to " + str(height-1) + ", col 0 to " + str(width-1) + ")")
    row,col = read_input("start row col number space and another number e.g. 0 0")
    goal_row,goal_col = read_input("goal row col number space and another number e.g. 0 0")
    start = (row,col)
    goal = (goal_row,goal_col)
    n = int(input("add number of forbidden squares: "))
    blocked = set()
    for _ in range(n):
        r,c = read_input("FORBIDDEN row col")
        blocked.add((r,c))

    p = dfs(start,goal,width,height,blocked)
    print("DFS:", fmt(p))
    p = bfs(start,goal,width,height,blocked)
    print("BFS:", fmt(p))
    p,d = iddfs(start,goal,width,height,blocked)
    if p is not None:
        print("IDDFS:", fmt(p), "depth", d)
    else:
        print("IDDFS:", fmt(p))

if __name__ == "__main__":
    main()
