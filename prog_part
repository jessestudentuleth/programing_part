# grid pathfinding dfs bfs iddfs, operators: up left right down
from collections import deque

MOVES = [(-1,0),(0,-1),(0,1),(1,0)]
NAMES = ["U","L","R","D"]

def valid(pos, width, height, blocked):
    r,c = pos
    return 0<=r<height and 0<=c<width and pos not in blocked

def neighbors(pos, width, height, blocked):
    out = []
    for (dr,dc), name in zip(MOVES, NAMES):
        n = (pos[0]+dr, pos[1]+dc)
        if valid(n, width, height, blocked):
            out.append((n, name))
    return out

def dfs(start, goal, width, height, blocked):
    stack = [(start, [])]
    seen = set()
    while stack:
        node, path = stack.pop()
        if node == goal:
            return path
        if node in seen:
            continue
        seen.add(node)
        for nxt, move in reversed(neighbors(node,width,height,blocked)):
            stack.append((nxt, path+[move]))
    return None

def bfs(start, goal, width, height, blocked):
    queue = deque([(start, [])])
    seen = {start}
    while queue:
        node, path = queue.popleft()
        if node == goal:
            return path
        for nxt, move in neighbors(node,width,height,blocked):
            if nxt not in seen:
                seen.add(nxt)
                queue.append((nxt, path+[move]))
    return None

def dls(node, goal, depth, width, height, blocked, seen):
    if node == goal:
        return []
    if depth == 0:
        return None
    seen.add(node)
    for nxt, move in neighbors(node,width,height,blocked):
        if nxt not in seen:
            rest = dls(nxt, goal, depth-1, width, height, blocked, seen)
            if rest is not None:
                return [move] + rest
    seen.remove(node)
    return None

def iddfs(start, goal, width, height, blocked, max_depth=200):
    for d in range(max_depth):
        result = dls(start, goal, d, width, height, blocked, set())
        if result is not None:
            return result, d
    return None, None

def fmt(path):
    if path is None:
        return "No path found the goal may be positioned out of grid"
    return " ".join(path) if path else "(already at goal)"

